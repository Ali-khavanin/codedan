# Copy to infra/.env and fill in what you have.
# Leave a line blank to skip it.
# Flags on provision.sh override VAST_HOST and VAST_PORT.

# Vast instance SSH address, from the instance page. The port changes every rental.
VAST_HOST=
VAST_PORT=
# VAST_USER=root

# Hugging Face read token. Public model downloads work without it.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Weights & Biases API key. Setup skips wandb login when this is empty.
# https://wandb.ai/authorize
WANDB_API_KEY=
