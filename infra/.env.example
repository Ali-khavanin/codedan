# Copy to infra/.env and fill in the keys you have.
# Both are optional. Leave a line blank to skip that login.
# Setup also reads /workspace/.env. A value already in the environment wins.

# Hugging Face token. Needed for gated models and higher download rate limits.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Weights & Biases API key. Setup skips wandb login when this is empty.
# https://wandb.ai/authorize
WANDB_API_KEY=
